{
  "name": "rebell-chess-3d",
  "private": true,
  "version": "0.8.3",
  "description": "Rebell Chess 3D – Premium-3D-Schach im Browser",
  "type": "module",
  "scripts": {
    "engine:copy": "node scripts/copy-engine.mjs",
    "assets:pieces": "node scripts/fetch-polyhaven.mjs && node scripts/build-pieces.mjs assets-src/polyhaven-chess-set/chess_set_1k.gltf public/models/pieces.glb && python -I scripts/build-ao.py assets-src/polyhaven-chess-set/textures/chess_set_pieces_white_arm_1k.jpg public/models/pieces_ao.jpg",
    "assets:warriors": "node scripts/build-warriors.mjs assets-src/mixamo/figuren/paladin_pack.fbx assets-src/mixamo/figuren/paladin_pack.fbx assets-src/mixamo/pack public/models src/scene",
    "shots": "node scripts/battle-shots.mjs",
    "assets:sounds": "python -I scripts/build-sounds.py assets-src/kenney-impact-sounds/kenney_impact-sounds.zip public/sounds",
    "predev": "npm run engine:copy",
    "dev": "vite",
    "dev:lan": "npm run engine:copy && vite --host",
    "prebuild": "npm run engine:copy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "assets:real": "node scripts/fetch-polyhaven.mjs && node scripts/build-pieces.mjs assets-src/polyhaven-chess-set/chess_set_1k.gltf public/models/pieces.glb public/models/board.glb && python -I scripts/build-real-textures.py assets-src public"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "chess.js": "^1.4.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.8.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
